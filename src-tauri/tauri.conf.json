{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishTorrnet",
  "version": "0.1.0",
  "identifier": "io.github.myfreeze-art.fishtorrnet",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast and honest BitTorrent client",
    "longDescription": "FishTorrnet is an open source BitTorrent client without ads or telemetry. Watch videos while they download, check torrents for malware with FishGuard and control downloads from your phone.",
    "copyright": "FishTorrnet contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "mimeType": "application/x-bittorrent",
        "name": "BitTorrent file",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "../packaging/linux/fishtorrnet.desktop",
        "recommends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/fishtorrnet.desktop",
        "recommends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "../packaging/branding/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian",
          "Ukrainian",
          "German",
          "French",
          "Spanish",
          "PortugueseBR",
          "SimpChinese",
          "Japanese",
          "Turkish"
        ],
        "headerImage": "../packaging/branding/nsis-header.bmp",
        "sidebarImage": "../packaging/branding/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "FishTorrnet",
        "compression": "lzma"
      },
      "wix": {
        "bannerPath": "../packaging/branding/wix-banner.bmp",
        "dialogImagePath": "../packaging/branding/wix-dialog.bmp"
      }
    },
    "publisher": "FishTorrnet contributors"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
