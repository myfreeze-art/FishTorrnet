{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishTorrnet",
  "version": "0.1.0",
  "identifier": "art.myfreeze.fishtorrnet",
  "build": {
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast and honest BitTorrent client",
    "longDescription": "FishTorrnet is an open source BitTorrent client without ads or telemetry. Watch videos while they download, check torrents for malware with FishGuard and control downloads from your phone.",
    "copyright": "FishTorrnet contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "mimeType": "application/x-bittorrent",
        "name": "BitTorrent file",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    }
  }
}
